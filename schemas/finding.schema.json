{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentic-ai-security-skills/schemas/finding.schema.json",
  "title": "Agentic AI Security Skills Normalized Finding",
  "description": "Canonical shape for findings emitted by any skill in this repository. See docs/normalized-json-output.md for examples.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run", "findings"],
  "properties": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "version", "started_at", "target"],
      "properties": {
        "skill": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "target": { "type": "string", "minLength": 1 },
        "agent_id": { "type": "string" },
        "session_id": { "type": "string" }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "severity", "framework_refs", "evidence", "remediations"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "severity": {
          "type": "string",
          "enum": ["info", "low", "medium", "high", "critical"]
        },
        "confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "framework_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["framework", "control_id"],
            "properties": {
              "framework": { "type": "string" },
              "control_id": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            }
          }
        },
        "cwe_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^CWE-\\d+$" }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["file", "log", "config", "api_call", "screenshot", "trace", "metric", "note"]
              },
              "path": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 },
              "snippet": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "remediations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["guidance", "confidence", "blast_radius", "behavior_change_risk", "test_strategy"],
            "properties": {
              "guidance": { "type": "string", "minLength": 1 },
              "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
              "blast_radius": { "type": "string" },
              "behavior_change_risk": { "type": "string", "enum": ["low", "medium", "high"] },
              "patch_path": { "type": "string" },
              "patch_diff": { "type": "string" },
              "test_strategy": {
                "type": "object",
                "required": ["summary"],
                "properties": {
                  "summary": { "type": "string" },
                  "recommended_tests": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/test" }
                  },
                  "generated_tests": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/test" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "test": {
      "type": "object",
      "required": ["name", "type", "purpose", "expected_result"],
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["static", "unit", "integration", "e2e", "regression", "manual"]
        },
        "purpose": { "type": "string" },
        "command": { "type": "string" },
        "expected_result": { "type": "string" }
      }
    }
  }
}
